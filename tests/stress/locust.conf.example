#
# Locust configuration for AI Horde stress tests.
#
# Copy this file to locust.conf and edit for your environment:
#     cp locust.conf.example locust.conf
#
# locust.conf is gitignored and supports Locust's built-in options only.
# Custom AI Horde options (API keys, models, etc.) must be set via CLI args
# or environment variables; see the "Custom options" section below for the
# env var names. Locust's --help output may only show built-in framework flags
# because help is handled before every locustfile-specific parser hook runs.
#
# Running:
#     cd tests/stress && locust                          # auto-finds locust.conf here
#     locust -f tests/stress/locustfile.py --config tests/stress/locust.conf   # from repo root
#
# Workload subsets use Locust's built-in tag filtering:
#     locust -f locustfile.py --tags hot
#     locust -f locustfile.py --tags meta
#     locust -f locustfile.py --exclude-tags misuse
#
# Staged ramp/sustain/cooldown profiles are opt-in so the default locustfile
# keeps the classic users/spawn-rate behavior:
#     locust -f locustfile_shaped.py --stress-shape-profile smoke

# ---------------------------------------------------------------------------
# Locust built-in options (set in this file, CLI, or LOCUST_* env vars)
# ---------------------------------------------------------------------------

locustfile = locustfile.py
host = http://localhost:7001
users = 20
spawn-rate = 5
# run-time = 5m
# headless = true

# ---------------------------------------------------------------------------
# Custom AI Horde options. Set via CLI args or env vars (NOT this file)
# ---------------------------------------------------------------------------
#
# API Keys (required for meaningful tests):
#   --requestor-api-keys / HORDE_REQUESTOR_API_KEYS
#       Comma-separated API keys for users submitting generation requests.
#       If empty, --bootstrap-requestors users will be auto-registered.
#
#   --worker-api-keys / HORDE_WORKER_API_KEYS
#       Comma-separated API keys for simulated workers popping/submitting jobs.
#       If empty, --bootstrap-workers users will be auto-registered.
#
#   --anonymous-api-key / HORDE_ANONYMOUS_API_KEY
#       API key for anonymous requests (default: 0000000000).
#
# Auto-bootstrap (local-only - fails silently if reCAPTCHA is enabled):
#   --bootstrap-requestors / HORDE_BOOTSTRAP_REQUESTORS    (default: 4)
#   --bootstrap-workers / HORDE_BOOTSTRAP_WORKERS          (default: 30)
#       NOTE: Untrusted users are capped at 3 distinct workers each. If you run
#             many WorkerSimulator/TextWorker/InterrogationWorker users, make
#             sure --bootstrap-workers >= ceil(total_worker_sims / 3).
#   --bootstrap-fail-hard / HORDE_BOOTSTRAP_FAIL_HARD      (default: false)
#       Abort the run if auto-registration fails instead of falling back to anon.
#
# Target preflight:
#   --skip-preflight / HORDE_SKIP_PREFLIGHT                (default: false)
#   --preflight-fail-hard / HORDE_PREFLIGHT_FAIL_HARD      (default: false)
#   --preflight-timeout / HORDE_PREFLIGHT_TIMEOUT          (default: 10.0 seconds)
#       Locust drives a running AI Horde deployment; it does not provision the
#       app's Postgres/Redis/R2 dependencies itself. The preflight check makes
#       that external stack contract explicit by probing /api/v2/status/heartbeat.
#
# Models:
#   --horde-models / HORDE_MODELS
#       Comma-separated model names (default includes stable_diffusion and
#       Flux.1-Schnell fp8 (Compact) for the flow-shift profile).
#
# Identity:
#   --client-agent / HORDE_CLIENT_AGENT
#       Client-Agent header (default: aihorde_stress_test:1.0.0:(discord)stress_tester).
#
# Generation parameters (standard):
#   --gen-width / HORDE_GEN_WIDTH             (default: 512)
#   --gen-height / HORDE_GEN_HEIGHT           (default: 512)
#   --gen-steps / HORDE_GEN_STEPS             (default: 20)
#   --gen-cfg-scale / HORDE_GEN_CFG_SCALE     (default: 7.0)
#
# Generation parameters (large/high-res):
#   --large-gen-width / HORDE_LARGE_GEN_WIDTH     (default: 1024)
#   --large-gen-height / HORDE_LARGE_GEN_HEIGHT   (default: 1024)
#   --large-gen-steps / HORDE_LARGE_GEN_STEPS     (default: 30)
#
# Worker simulation:
#   --worker-max-pixels / HORDE_WORKER_MAX_PIXELS         (default: 4194304)
#   --worker-bridge-agent / HORDE_WORKER_BRIDGE_AGENT     (default: AI Horde Worker reGen:17.0.0-stress:...)
#   --legacy-worker-bridge-agent / HORDE_LEGACY_WORKER_BRIDGE_AGENT
#                                                         (default: AI Horde Worker reGen:16.0.0-stress:...)
#   --legacy-image-workers / HORDE_LEGACY_IMAGE_WORKERS   (default: 0 / weight-based)
#   --extended-image-workers / HORDE_EXTENDED_IMAGE_WORKERS
#                                                         (default: 0 / weight-based)
#   --sim-gen-time-min / HORDE_SIM_GEN_TIME_MIN           (default: 4.0 seconds)
#   --sim-gen-time-max / HORDE_SIM_GEN_TIME_MAX           (default: 120.0 seconds)
#
# Targeted feature coverage:
#   --sampler-feature-requestors / HORDE_SAMPLER_FEATURE_REQUESTORS (default: 0)
#       Cycles every extended sampler through zero/all applicable settings and
#       proper subsets where possible; also covers Flux flow_shift.
#
# User behavior:
#   --anon-chance-poller / HORDE_ANON_CHANCE_POLLER       (default: 0.75)
#   --anon-chance-requester / HORDE_ANON_CHANCE_REQUESTER (default: 0.65)
#
# Chat contract mix (opt-in; every count 0 leaves the chat users out; see README "Chat contract mix"):
#   --chat-mix-front-host / HORDE_CHAT_MIX_FRONT_HOST           (front base URL, with or without /v1)
#   --chat-mix-front-clients / HORDE_CHAT_MIX_FRONT_CLIENTS     (default: 0)
#   --chat-mix-native-clients / HORDE_CHAT_MIX_NATIVE_CLIENTS   (default: 0)
#   --chat-mix-workers / HORDE_CHAT_MIX_WORKERS                 (default: 0)
#   --chat-mix-worker-names / HORDE_CHAT_MIX_WORKER_NAMES       (default: generated names; one per chat worker of the whole run)
#   --chat-mix-worker-api-key / HORDE_CHAT_MIX_WORKER_API_KEY   (the key owning every configured name; required with them)
#   --chat-mix-worker-personas / HORDE_CHAT_MIX_WORKER_PERSONAS (default: conformant,limited,flaky; taken in turn by the worker slots)
#   --chat-mix-model, --chat-mix-limited-model, --chat-mix-flaky-model
#                                                               (default: stress/chat-conformant, -limited, -flaky)
#   --chat-mix-flaky-rate / HORDE_CHAT_MIX_FLAKY_RATE           (default: 0.3)
#   --chat-mix-group-weights / HORDE_CHAT_MIX_GROUP_WEIGHTS     (default: ordinary=6,tools=4,structured=3,
#                                                                conformance=2,gap=2,misuse=3,lite=2,vision=1)
#   --chat-mix-stream-chance, --chat-mix-include-usage-chance   (default: 0.5, 0.5)
#   --chat-mix-anonymous-share / HORDE_CHAT_MIX_ANONYMOUS_SHARE (default: 0.1 of ordinary and lite scenarios)
#   --chat-mix-gen-time-min, --chat-mix-gen-time-max            (default: 1.0, 3.0 seconds)
#   --chat-mix-aborting-per-hour, --chat-mix-oversized-per-hour (default: 2 in the whole run, at most 6; 2)
#   --chat-mix-vision, --chat-mix-skip-fault-verify             (flags)
#
# Staged load shape (only when using locustfile_shaped.py):
#   --stress-shape-profile / HORDE_STRESS_SHAPE_PROFILE   (smoke|baseline|spike; default: baseline)
#   --stress-shape-scale / HORDE_STRESS_SHAPE_SCALE       (default: 1.0)
#
# Task tags:
#   image, text, interrogation, meta, misuse, hot, cold, status, worker,
#   requestor, sampler-features, chat, chat-front, chat-native, chat-worker
